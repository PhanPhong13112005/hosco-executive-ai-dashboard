# Development-only examples. Never commit real credentials.
ConnectionStrings__HoscoDb=Server=localhost;Database=HoscoGd6Demo;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Issuer=Hosco.Api
Jwt__Audience=Hosco.Clients
Jwt__SigningKey=replace-with-at-least-32-random-characters-via-process-env
Seed__Enabled=true

# Demo process only: SQLite RAM, no SQL Server and no persistence.
Database__Provider=Sqlite
Swagger__Enabled=true
AlertScheduler__Enabled=false
AlertScheduler__IntervalMinutes=15
AlertScheduler__RunOnStartup=false
Notifications__Telegram__Enabled=false
Notifications__Telegram__BotToken=
Notifications__Telegram__DefaultChatId=
# Frontend only, same-origin /api through the Vite proxy to localhost:5000.
VITE_API_BASE_URL=

# Backend only. .NET does not automatically load this file; set process environment
# variables or explicitly registered secret-manager configuration before startup.
# Current projects have no UserSecretsId; user-secrets are not auto-loaded.
# Never use VITE_* for provider credentials or commit real keys.
AI_PROVIDER=Mock
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=1
