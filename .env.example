# Development-only examples. Never commit real credentials.
ConnectionStrings__HoscoDb=Server=localhost;Database=Hosco;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Issuer=Hosco.Api
Jwt__Audience=Hosco.Clients
Jwt__SigningKey=replace-with-at-least-32-random-characters-via-user-secrets
Seed__Enabled=true
