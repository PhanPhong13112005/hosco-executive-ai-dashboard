# Development-only examples. Never commit real credentials.
ConnectionStrings__HoscoDb=Server=localhost;Database=Hosco;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Issuer=Hosco.Api
Jwt__Audience=Hosco.Clients
Jwt__SigningKey=replace-with-at-least-32-random-characters-via-user-secrets
Seed__Enabled=true

# Backend only. .NET does not automatically load this file; set process environment
# variables or user-secrets/secret-manager configuration before starting Hosco.Api.
# Never use VITE_* for provider credentials or commit real keys.
AI_PROVIDER=Mock
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=1
