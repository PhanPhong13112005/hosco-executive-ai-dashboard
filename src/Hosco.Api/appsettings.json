{
  "ConnectionStrings": {
    "HoscoDb": "Server=(localdb)\\MSSQLLocalDB;Database=HoscoDev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "Hosco.Api",
    "Audience": "Hosco.Clients",
    "SigningKey": "DEVELOPMENT-ONLY-REPLACE-USING-USER-SECRETS-2026",
    "ExpiryMinutes": 60
  },
  "Seed": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "AlertScheduler": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "RunOnStartup": false
  },
  "Notifications": {
    "Telegram": {
      "Enabled": false,
      "BotToken": "",
      "DefaultChatId": "",
      "DefaultTenantId": null,
      "DefaultBranchId": null,
      "TimeoutSeconds": 10,
      "MaxRetries": 3,
      "BaseRetryDelayMilliseconds": 500
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
